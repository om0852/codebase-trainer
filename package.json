{
  "name": "codebase-trainer",
  "version": "2.0.1",
  "description": "Local, offline codebase context for AI coding agents: feature slices across UI, API and data layers, flow tracing, impact and test selection, diff review and a permission map, over MCP or CLI",
  "homepage": "https://om0852.github.io/codebase-trainer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/om0852/codebase-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/om0852/codebase-trainer/issues"
  },
  "main": "dist/cli/index.js",
  "bin": {
    "cb-trainer": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "start": "node dist/cli/index.js mcp",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "bench": "tsx bench/run.ts",
    "bench:setup": "tsx bench/corpus.ts",
    "bench:links": "tsx bench/links.ts",
    "bench:permissions": "tsx bench/permissions.ts",
    "bench:test-impact": "tsx bench/test-impact.ts",
    "bench:scale": "tsx bench/scale.ts",
    "security": "node dist/cli/index.js security",
    "audit": "node dist/cli/index.js audit",
    "ci": "node dist/cli/index.js ci",
    "watch": "node dist/cli/index.js watch",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "docker:build": "docker build -t codebase-trainer:latest .",
    "docker:run": "docker run -i codebase-trainer:latest mcp"
  },
  "keywords": [
    "mcp",
    "codebase-index",
    "ai-agent",
    "context-pack",
    "bm25-search",
    "ast-facts",
    "call-graph",
    "claude-code",
    "cursor",
    "model-context-protocol",
    "ai-coding-agent",
    "code-search",
    "feature-slice",
    "impact-analysis",
    "test-impact"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.2",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
